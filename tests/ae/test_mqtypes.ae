// Unit tests for ae/mqtypes packed engine overlays.

import std.spec
import ae.mqtypes
import std.mem

extern malloc(n: long) -> ptr
extern free(p: ptr)


u32_word(p: ptr) -> long {
    return mem.get_uint32(p, 16) & 0xffffffff
}

main() {
    fw = spec.init()

    spec.describe(fw, "mqtypes JSProperty flags") {
        spec.it("reads packed hash_next and prop_type without sign extension") callback {
            p = malloc(24)
            mem.set_uint32(p, 16, 0xffffffff)

            spec.assert_eq_long(mqtypes.js_prop_hash_next(p), 0x3fffffff, "hash_next all ones")
            spec.assert_eq(mqtypes.js_prop_type(p), 3, "prop_type all ones")

            free(p)
        }

        spec.it("writes hash_next without disturbing prop_type") callback {
            p = malloc(24)
            mem.set_uint32(p, 16, 0xffffffff)

            mqtypes.js_prop_set_hash_next(p, 5)

            spec.assert_eq_long(mqtypes.js_prop_hash_next(p), 5, "hash_next")
            spec.assert_eq(mqtypes.js_prop_type(p), 3, "prop_type preserved")
            spec.assert_eq_long(u32_word(p), 0xc0000005, "packed word")

            free(p)
        }

        spec.it("writes prop_type without disturbing hash_next") callback {
            p = malloc(24)
            mem.set_uint32(p, 16, 0x00000015)

            mqtypes.js_prop_set_type(p, 2)

            spec.assert_eq_long(mqtypes.js_prop_hash_next(p), 0x15, "hash_next preserved")
            spec.assert_eq(mqtypes.js_prop_type(p), 2, "prop_type")
            spec.assert_eq_long(u32_word(p), 0x80000015, "packed word")

            free(p)
        }
    }

    return spec.run_summary(fw)
}
