// Unit test for ae/jsbool short-float codec, against C reference
// values computed from the upstream rotl64+addend encoding.

import std.spec
import ae.jsbool
import std.mem


main() {
    fw = spec.init()

    spec.describe(fw, "short-float codec") {
        spec.it("to_short_float matches C reference") callback {
            // 1.5 -> 0x7f80000000000005
            v = jsbool.js_to_short_float(1.5)
            spec.assert_eq_long(v, 0x7f80000000000005, "1.5 encode")
            // 100.0 -> 0x8590000000000005
            v2 = jsbool.js_to_short_float(100.0)
            spec.assert_eq_long(v2, 0x8590000000000005, "100 encode")
        }
        spec.it("round-trips") callback {
            a = jsbool.js_to_short_float(1.5)
            b = jsbool.js_get_short_float(a)
            ok = 0
            if b == 1.5 { ok = 1 }
            spec.assert_eq(ok, 1, "1.5 round-trip")
            c = jsbool.js_to_short_float(0.0 - 2.25)
            d = jsbool.js_get_short_float(c)
            ok2 = 0
            if d == (0.0 - 2.25) { ok2 = 1 }
            spec.assert_eq(ok2, 1, "-2.25 round-trip")
        }
    }

    return spec.run_summary(fw)
}
