// Unit test for ae/regexp_flags — parse/format round-trip.

import std.spec
import ae.regexp_flags
import std.mem

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern strcpy(d: ptr, s: ptr) -> ptr

main() {
    fw = spec.init()

    spec.describe(fw, "regexp_flags") {
        spec.it("parses gimsuy") callback {
            s = malloc(16)
            strcpy(s, "gi")
            slot = malloc(8)
            n = regexp_flags.js_parse_regexp_flags(slot, s)
            fl = mem.get_int(slot, 0)
            spec.assert_eq(n, 2, "2 chars")
            spec.assert_eq(fl, 3, "g|i = 3")
            free(slot)
            free(s)
        }
        spec.it("stops at unknown flag") callback {
            s = malloc(16)
            strcpy(s, "gx")
            slot = malloc(8)
            n = regexp_flags.js_parse_regexp_flags(slot, s)
            fl = mem.get_int(slot, 0)
            spec.assert_eq(n, 1, "1 char")
            spec.assert_eq(fl, 1, "g = 1")
            free(slot)
            free(s)
        }
        spec.it("stops at repeated flag") callback {
            s = malloc(16)
            strcpy(s, "gg")
            slot = malloc(8)
            n = regexp_flags.js_parse_regexp_flags(slot, s)
            spec.assert_eq(n, 1, "1 char (repeat stops)")
            free(slot)
            free(s)
        }
        spec.it("formats back to chars") callback {
            buf = malloc(8)
            // g|m|y = 1|4|32 = 37
            n = regexp_flags.js_regexp_flags_str(buf, 37)
            spec.assert_eq(n, 3, "3 chars")
            c0 = mem.get_byte(buf, 0)
            c1 = mem.get_byte(buf, 1)
            c2 = mem.get_byte(buf, 2)
            term = mem.get_byte(buf, 3)
            spec.assert_eq(c0, 0x67, "g")
            spec.assert_eq(c1, 0x6d, "m")
            spec.assert_eq(c2, 0x79, "y")
            spec.assert_eq(term, 0, "nul")
            free(buf)
        }
    }

    return spec.run_summary(fw)
}
