// The embedding-demo binary. Links example.c (a host embedding the
// engine with a custom Rectangle class) against the same engine
// sources mqjs uses. Depends on the shared gen node for the atom
// table and its own gen node for example_stdlib.h.

import bldr
import bldr (dep)
import c
import c (sources, aether_source, cflag, link_flag, output_file, aether_home)
import gen.mqjssources
import std.os
import std.string

aether_root() -> string {
    // Not AETHER_HOME: that names the toolchain aeb itself runs on (often an
    // installed ~/.aether release), while the engine builds against a dev tree.
    root = os.getenv("MQJS_AETHER_HOME")
    if string.length(root) > 0 { return root }
    return "/home/paul/scm/aether"
}

aeb(cap) {
    bldr.build() {
        dep("gen/.build.ae")
        dep("example-app/gen/.build.ae")
        c.program() {
            cflag("-Os")
            cflag("-D_GNU_SOURCE")
            cflag("-fno-math-errno")
            cflag("-fno-trapping-math")
            cflag("-I..")
            aether_home(aether_root())

            // Engine (shared with mqjs, single source of truth).
            mqjssources.register_engine_c_sources("..")
            mqjssources.register_engine_sources("../ae")

            // Embedding host.
            sources("../example.c")

            link_flag("-lm")
            output_file("example")
        }
    }
}
