// The mqjs CLI binary. The engine is built from shared Aether sources plus
// the small remaining C support set; generated headers come from gen/.

import bldr
import bldr (dep)
import c
import c (sources, aether_source, cflag, link_flag, output_file, aether_home, aether_caps)
import gen.mqjssources
import std.os
import std.string

aether_root_() -> string {
    // Not AETHER_HOME: that names the toolchain aeb itself runs on (often an
    // installed ~/.aether release), while the engine builds against a dev tree.
    root = os.getenv("MQJS_AETHER_HOME")
    if string.length(root) > 0 { return root }
    return "/home/paul/scm/aether"
}

aeb(cap) {
    bldr.build() {
        dep("gen/.build.ae")
        c.program() {
            cflag("-Os")
            cflag("-D_GNU_SOURCE")
            cflag("-fno-math-errno")
            cflag("-fno-trapping-math")
            cflag("-I.")
            aether_home(aether_root_())
            // The CLI host (ae/cli_host.ae) reads/writes files and uses the
            // clock via std.fs / std.os; this binary owns those capabilities.
            aether_caps("fs,os")

            // Engine sources, shared with the embedding example.
            mqjssources.register_engine_c_sources(".")
            mqjssources.register_engine_sources("ae")

            // CLI front-end.
            aether_source("ae/cli_host.ae")
            aether_source("ae/mqjs_dsl/module.ae")
            aether_source("ae/readline.ae")
            sources("mqjs.c")
            sources("readline_tty.c")

            link_flag("-lpthread")
            link_flag("-ldl")
            link_flag("-lm")
            output_file("mqjs")
        }
        return 0
    }
}
